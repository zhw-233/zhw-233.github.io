---
import type { CollectionEntry } from 'astro:content';
import { comparisonSizes } from '../lib/project-media';
import { sitePath } from '../lib/site';

interface Props { comparison: NonNullable<CollectionEntry<'projects'>['data']['comparison']> }
const { comparison } = Astro.props;
const sizes = comparisonSizes(comparison);
---
<figure class="comparison">
  <div class="crop">
    <img class="original" src={sitePath(comparison.original)} alt={'原图局部：' + comparison.alt} />
    <img class="compressed" src={sitePath(comparison.compressed)} alt={'压缩后同一处：' + comparison.alt} />
  </div>
  <fieldset>
    <legend class="sr-only">选择对照样张</legend>
    <label><input type="radio" name="comparison-image" value="original" checked />原图</label>
    <label><input type="radio" name="comparison-image" value="compressed" />压缩后</label>
  </fieldset>
  <figcaption>
    <a class="original" href={sitePath(comparison.original)} aria-label={'查看完整原图，' + sizes.original}>{sizes.original} ↗</a>
    <a class="compressed" href={sitePath(comparison.compressed)} aria-label={'查看完整压缩图，' + sizes.compressed}>{sizes.compressed} ↗</a>
  </figcaption>
</figure>
<style>
  .comparison { margin: 22px 0; display: grid; grid-template-columns: 1fr auto; gap: 7px 12px; align-items: baseline; }
  .crop { grid-column: 1 / -1; aspect-ratio: 3.45; overflow: hidden; background: var(--soft); }
  .crop img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 44%; transform: scale(1.6); transform-origin: 50% 43%; }
  .compressed { display: none; }
  .comparison:has(input[value="compressed"]:checked) .original { display: none; }
  .comparison:has(input[value="compressed"]:checked) .compressed { display: block; }
  fieldset { display: flex; gap: 18px; align-items: center; min-width: 0; margin: 0; padding: 0; border: 0; }
  label { position: relative; padding-block: 3px; color: var(--muted); font-size: .875rem; cursor: pointer; }
  label:has(:checked) { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  label:has(:focus-visible) { outline: 2px dashed var(--accent); outline-offset: 3px; }
  input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  figcaption a { color: var(--muted); font: .8125rem var(--mono); text-decoration: none; }
  @media (max-width: 480px) { .crop { aspect-ratio: 2; } }
  @media (pointer: coarse) { label, figcaption a { min-height: 44px; display: inline-flex; align-items: center; } figcaption .compressed { display: none; } }
</style>
