---
import type { CollectionEntry } from 'astro:content';
import { noteDate, sitePath } from '../lib/site';

interface Props { note: CollectionEntry<'notes'>; heading?: 'h2' | 'h3' }
const { note, heading: Heading = 'h2' } = Astro.props;
const { data } = note;
const date = noteDate(data.date);
---
<article class="note-row">
  <a class="entry-link" href={sitePath('notes/' + note.id + '/')} aria-label={'阅读笔记：' + data.title}>
    <div class="entry-copy">
      <Heading class="item-title">{data.title}</Heading>
      <time datetime={date}>{date}</time>
      <p>{data.summary}</p>
    </div>
  </a>
</article>
