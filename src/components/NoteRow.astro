---
import type { CollectionEntry } from 'astro:content';
import { noteDate, sitePath } from '../lib/site';

interface Props { note: CollectionEntry<'notes'>; heading?: 'h2' | 'h3' }
const { note, heading: Heading = 'h2' } = Astro.props;
const { data } = note;
const date = noteDate(data.date);
---
<article class="note-row">
  <a href={sitePath('notes/' + note.id + '/')} class="note-link">
    <div class="note-meta"><time datetime={date}>{date.replaceAll('-', '.')}</time><span>{data.category}</span></div>
    <div class="note-text"><Heading>{data.title}</Heading><p>{data.summary}</p></div>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </a>
</article>
