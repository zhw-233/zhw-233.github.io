---
import { sitePath } from '../lib/site';

interface Props { cover: { path: string; alt: string }; closeup?: boolean }
const { cover, closeup = false } = Astro.props;
---
<span class:list={['project-thumb', { closeup }]}>
  <img src={sitePath(cover.path)} alt={cover.alt} loading="lazy" decoding="async" />
</span>
