---
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../lib/site';
import ProjectArt from './ProjectArt.astro';

interface Props { project: CollectionEntry<'projects'>; heading?: 'h2' | 'h3' }
const { project, heading: Heading = 'h2' } = Astro.props;
const { data } = project;
---
<article class="project-card">
  <a class="card-link" href={sitePath('projects/' + project.id + '/')} aria-label={'查看项目：' + data.title}>
    <ProjectArt project={project} />
    <div class="card-meta">{data.category}</div>
    <div class="card-heading"><Heading>{data.title}</Heading><span class="card-arrow" aria-hidden="true">↗</span></div>
    <p>{data.summary}</p>
    <ul class="tags" aria-label="使用的技术">{data.stack.map((item) => <li>{item}</li>)}</ul>
  </a>
</article>
