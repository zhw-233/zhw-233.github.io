---
import type { MarkdownHeading } from 'astro';
import SiteLayout from './SiteLayout.astro';
import { site, sitePath } from '../lib/site';

interface Props {
  section: 'projects' | 'notes';
  title: string;
  description: string;
  category: string;
  headings: MarkdownHeading[];
  date?: string;
  tags?: string[];
  image?: string;
  action?: { href: string; label: string; download?: boolean };
}
const { section, title, description, category, headings, date, tags = [], image, action } = Astro.props;
const sectionName = section === 'projects' ? '项目' : '笔记';
const back = sitePath(section + '/');
const sections = headings.filter((heading) => heading.depth === 2);
---
<SiteLayout title={title + ' · ' + site.name} {description} {section} {image} article>
  <article class="shell entry">
    <header class="entry-header">
      <a class="backlink" href={back}><span aria-hidden="true">←</span> 全部{sectionName}</a>
      <div class="entry-meta"><span>{category}</span>{date && <time datetime={date}>{date.replaceAll('-', '.')}</time>}</div>
      <h1>{title}</h1>
      <p class="entry-deck">{description}</p>
      {tags.length > 0 && <ul class="tags" aria-label={section === 'projects' ? '使用的技术' : '标签'}>{tags.map((tag) => <li>{tag}</li>)}</ul>}
    </header>
    <div class="reading-layout">
      <div class="reading-column">
        <slot name="media" />
        <div class="prose"><slot /></div>
        {action && <div class="entry-actions"><a class="button primary" href={action.href} download={action.download}>{action.label} <span aria-hidden="true">{action.download ? '↓' : '↗'}</span></a></div>}
      </div>
      {sections.length > 0 && <aside class="toc">
        <nav aria-label="本文目录">
          <strong>本文目录</strong>
          <ul>{sections.map((heading) => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ul>
        </nav>
      </aside>}
    </div>
  </article>
</SiteLayout>
