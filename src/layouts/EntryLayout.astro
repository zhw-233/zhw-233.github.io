---
import type { MarkdownHeading } from 'astro';
import SiteLayout from './SiteLayout.astro';
import { site, sitePath } from '../lib/site';

interface Props {
  section: 'projects' | 'notes';
  title: string;
  description: string;
  category: string;
  draft: boolean;
  headings: MarkdownHeading[];
  date?: string;
  tags?: string[];
  image?: string;
  repo?: string;
  download?: { path: string; label: string };
}
const { section, title, description, category, draft, headings, date, tags = [], image, repo, download } = Astro.props;
const sectionName = section === 'projects' ? '项目' : '笔记';
const sections = headings.filter(heading => heading.depth === 2);
const attachment = download && sitePath(download.path);
---
<SiteLayout title={title + ' · ' + site.name} {description} {section} {image} article>
  <article class="detail">
    <a class="backlink" href={sitePath(section + '/')}>← {sectionName}</a>
    <header class="detail-head">
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="entry-meta">
        {draft && <span>本地草稿</span>}
        {date && <time datetime={date}>{date}</time>}
        <span>{category}</span>
        {tags.length > 0 && <span class="tech">{tags.join(' / ')}</span>}
        {repo && <a href={repo}>项目源码 <span aria-hidden="true">↗</span></a>}
      </div>
    </header>
    <slot name="media" />
    {sections.length > 1 && <details class="toc">
      <summary>本文目录</summary>
      <nav aria-label="本文目录"><ul>{sections.map(heading => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ul></nav>
    </details>}
    <div class="prose"><slot /></div>
    {attachment && download && <div class="attachment">
      <a href={attachment} download>{download.label} <span aria-hidden="true">↓</span></a>
      {/\.pdf$/i.test(download.path) && <details>
        <summary>预览 PDF</summary>
        <iframe src={attachment + '#page=1&view=FitH'} title={title + '的 PDF 附件'} loading="lazy"></iframe>
        <a href={attachment}>打开完整 PDF <span aria-hidden="true">↗</span></a>
      </details>}
    </div>}
  </article>
</SiteLayout>
