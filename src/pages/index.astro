---
import SiteLayout from '../layouts/SiteLayout.astro';
import CompressionDemo from '../components/CompressionDemo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
import { listNotes, listProjects } from '../lib/entries';
import { site, sitePath } from '../lib/site';

const [projects, notes] = await Promise.all([listProjects(), listNotes()]);
const demo = projects.find((project) => project.data.visual === 'imgshift');
---
<SiteLayout title={site.name + ' · 个人作品与笔记'} section="home">
  <div class="shell">
    <section class="hero" aria-labelledby="intro">
      <div class="hero-copy">
        <h1 id="intro"><span class="greeting">你好，我是</span><span class="signature">{site.name}<span>.</span></span></h1>
        <p>{site.introduction}</p>
        <div class="hero-links">
          <a class="button primary" href={sitePath('projects/')}>查看项目 <span aria-hidden="true">→</span></a>
          <a class="text-link" href={sitePath('notes/')}>阅读笔记 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <CompressionDemo featured projectUrl={demo && sitePath('projects/' + demo.id + '/')} />
    </section>
    {projects.length > 0 && <section class="home-section" aria-labelledby="selected-projects">
      <div class="section-head"><h2 id="selected-projects">精选项目</h2><a class="section-link" href={sitePath('projects/')}>全部项目 <span aria-hidden="true">→</span></a></div>
      <div class="project-grid">{projects.slice(0, 2).map((project) => <ProjectCard project={project} heading="h3" />)}</div>
    </section>}
    {notes.length > 0 && <section class="home-section notes-section" aria-labelledby="recent-writing">
      <div class="section-head"><h2 id="recent-writing">最近的笔记</h2><a class="section-link" href={sitePath('notes/')}>全部笔记 <span aria-hidden="true">→</span></a></div>
      {notes.slice(0, 3).map((note) => <NoteRow note={note} heading="h3" />)}
    </section>}
  </div>
</SiteLayout>
