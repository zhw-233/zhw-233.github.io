---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
import { listProjects, listNotes } from '../lib/entries';
import { site, sitePath } from '../lib/site';

const [projects, notes] = await Promise.all([listProjects(), listNotes()]);
const homeProjects = projects.slice(0, 2);
const homeNotes = notes.slice(0, 3);
---
<SiteLayout title={site.name + ' · 作品与笔记'} section="home">
  <header class="page-intro">
    <h1>作品与笔记</h1>
    <p>{site.introduction}</p>
  </header>
  {homeProjects.length > 0 && <section class="index-block" aria-labelledby="projects">
    <div class="section-head">
      <h2 id="projects">项目</h2>
      {projects.length > homeProjects.length && <a href={sitePath('projects/')}>全部项目 →</a>}
    </div>
    <div class="entries">{homeProjects.map(project => <ProjectCard {project} heading="h3" />)}</div>
  </section>}
  {homeNotes.length > 0 && <section class="index-block" aria-labelledby="notes">
    <div class="section-head">
      <h2 id="notes">笔记</h2>
      {notes.length > homeNotes.length && <a href={sitePath('notes/')}>全部笔记 →</a>}
    </div>
    <div class="entries">{homeNotes.map(note => <NoteRow {note} heading="h3" />)}</div>
  </section>}
</SiteLayout>
