---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { listNotes } from '../../lib/entries';
import { noteDate, sitePath } from '../../lib/site';

export const getStaticPaths = (async () => {
  const notes = await listNotes();
  return notes.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const action = data.attachment ? { href: sitePath(data.attachment), label: data.attachmentLabel || '下载附件', download: true } : undefined;
---
<EntryLayout section="notes" title={data.title} description={data.summary} category={data.category} {headings} date={noteDate(data.date)} tags={data.tags} image={data.cover?.path} {action}>
  <Content />
</EntryLayout>
