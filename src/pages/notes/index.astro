---
import SiteLayout from '../../layouts/SiteLayout.astro';
import NoteRow from '../../components/NoteRow.astro';
import { listNotes } from '../../lib/entries';
import { site, sitePath } from '../../lib/site';

const notes = await listNotes();
---
<SiteLayout title={'笔记 · ' + site.name} section="notes">
  <a class="backlink" href={sitePath()}>← 首页</a>
  <header class="list-heading"><h1>笔记</h1></header>
  <div class="entries">{notes.map(note => <NoteRow {note} />)}</div>
  {notes.length === 0 && <p>暂时还没有公开笔记。</p>}
</SiteLayout>
