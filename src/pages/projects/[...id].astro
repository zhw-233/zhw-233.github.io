---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import CompressionDemo from '../../components/CompressionDemo.astro';
import GomokuDemo from '../../components/GomokuDemo.astro';
import { listProjects } from '../../lib/entries';
import { projectMedia } from '../../lib/project-media';
import { sitePath } from '../../lib/site';

export const getStaticPaths = (async () => {
  const projects = await listProjects(import.meta.env.DEV);
  return projects.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const { comparison, cover } = projectMedia(data);
const download = data.sourceDownload && { path: data.sourceDownload, label: '下载项目源码' };
---
<EntryLayout section="projects" title={data.title} description={data.summary} category={data.category} draft={data.draft} {headings} tags={data.stack} image={cover?.path} repo={data.repo} download={download || undefined}>
  <Fragment slot="media">
    {comparison ? <CompressionDemo {comparison} /> : data.visual === 'gomoku' ? <GomokuDemo /> : cover &&
      <figure class="entry-figure"><img src={sitePath(cover.path)} alt={cover.alt} /></figure>}
  </Fragment>
  <Content />
</EntryLayout>
