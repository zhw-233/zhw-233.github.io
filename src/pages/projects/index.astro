---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { listProjects } from '../../lib/entries';
import { site, sitePath } from '../../lib/site';

const projects = await listProjects();
---
<SiteLayout title={'项目 · ' + site.name} section="projects">
  <a class="backlink" href={sitePath()}>← 首页</a>
  <header class="list-heading"><h1>项目</h1></header>
  <div class="entries">{projects.map(project => <ProjectCard {project} />)}</div>
  {projects.length === 0 && <p>暂时还没有公开项目。</p>}
</SiteLayout>
